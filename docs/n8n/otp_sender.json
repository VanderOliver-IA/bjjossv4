{
    "name": "BjjOss - WhatsApp OTP Sender",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "otp-send",
                "options": {}
            },
            "id": "webhook-trigger",
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [ 100, 300 ],
            "webhookId": "bjjoss-otp-send"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $json.evolution_url + '/message/sendText/' + $json.evolution_instance }}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "apikey",
                            "value": "={{ $json.evolution_apikey }}"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"number\": \"{{ $json.phone }}\",\n  \"text\": \"🥋 *BjjOss*\n\nSeu código de verificação é: *{{ $json.code }}*\n\nEste código expira em 10 minutos.\"\n}",
                "options": {}
            },
            "id": "evolution-api-sender",
            "name": "Evolution API",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [ 400, 300 ]
        }
    ],
    "connections": {
        "Webhook": {
            "main": [ [ { "node": "Evolution API", "type": "main", "index": 0 } ] ]
        }
    }
}
